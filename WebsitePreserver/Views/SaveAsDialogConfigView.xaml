<UserControl x:Class="WebsitePreserver.Views.SaveAsDialogConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WebsitePreserver.Views"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Right">
        <Grid.RowDefinitions>
            <!--<RowDefinition Height="*"/>-->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto" MaxWidth="250"/>
        </Grid.ColumnDefinitions>

        <TextBox Grid.Row="0" Grid.Column="0"
                   VerticalAlignment="Center" HorizontalContentAlignment="Left"
                   BorderThickness="0" IsReadOnly="True"
                   Text="Save As Dialog Title:"/>

        <TextBox Grid.Row="0" Grid.Column="1"
                 Controls:TextBoxHelper.Watermark="&quot;Save As&quot;" 
                 BorderThickness="0"  
                 VerticalAlignment="Center" HorizontalContentAlignment="Left"
                         Text="{Binding 
            Path=SaveAsDialogConfigVM.SaveAsDialogTitle,
            Mode=TwoWay,UpdateSourceTrigger=PropertyChanged
            }"/>


        <!--<TextBox Grid.Row="1" Grid.Column="0"
                VerticalAlignment="Center" HorizontalContentAlignment="Left"
                BorderThickness="0" IsReadOnly="True"
                Text="Confirm Save As Dialog:"/>

        <TextBox Grid.Row="1" Grid.Column="1"
                 Controls:TextBoxHelper.Watermark="Enter Confirm Save As Dialog Title (Required)" 
                 BorderThickness="0"  
                 VerticalAlignment="Center" HorizontalContentAlignment="Left"
                         Text="{Binding 
            Path=SaveAsDialogConfigVM.ConfirmSaveAsDialogTitle,
            Mode=TwoWay,UpdateSourceTrigger=PropertyChanged
            }"/>-->


    </Grid>
</UserControl>
